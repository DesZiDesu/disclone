# ---- Discord credentials ----
# Your bot token from https://discord.com/developers/applications  (Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID from the "General Information" page of your app
CLIENT_ID=your-application-id-here

# OPTIONAL: A single guild (server) ID to register the slash commands instantly while testing.
# Leave empty to register the commands globally (can take up to 1 hour to appear).
GUILD_ID=
